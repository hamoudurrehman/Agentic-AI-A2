# GigBid Environment Configuration Example
# Copy to .env for local runtime overrides. NEVER commit real secrets.

PORT=8000
MARKETPLACE_MODE=gigsim # "gigsim" or "upwork_live"
ACTIVE_PROFILE=open     # "open" or "paid"

# Upwork Official MCP Credentials (for Live mode)
UPWORK_CLIENT_ID=your_upwork_oauth_client_id_here
UPWORK_CLIENT_SECRET=your_upwork_oauth_client_secret_here
UPWORK_REDIRECT_URI=http://localhost:8000/auth/callback/upwork

# Infrastructure Services
DATABASE_URL=postgresql://gigbid:gigbidpass@localhost:5432/gigbid_db
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434

# Observability
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
